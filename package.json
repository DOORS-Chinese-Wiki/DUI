{
  "name": "dui",
  "private": true,
  "version": "0.1.2",
  "description": "DOORS 风格的 React 组件库，支持 MediaWiki 嵌入。",
  "repository": { "type": "git", "url": "https://github.com/DOORS-Chinese-Wiki/DUI.git" },
  "homepage": "https://doors-chinese-wiki.github.io/DUI/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mediawiki": "tsc --noEmit && vite build --config vite.mediawiki.config.ts && tsc -p tsconfig.mediawiki.json && node scripts/package-mediawiki.mjs",
    "pack:mediawiki": "npm run build:mediawiki && npm pack ./dist-mediawiki --pack-destination ./artifacts",
    "test:mediawiki": "npm run build:mediawiki && playwright test --config playwright.mediawiki.config.ts",
    "build:pages": "npm run build:mediawiki && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run test && npm run build && npm run build-storybook"
  },
  "dependencies": {
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "misans": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
